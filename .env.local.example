# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# NIM (NVIDIA)
NIM_API_KEY=your_nim_api_key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Twilio (WhatsApp legacy — only if still using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+your_number

# Meta WhatsApp Cloud API
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# WeChat Work
WECHAT_WORK_CORP_ID=your_corp_id
WECHAT_WORK_AGENT_ID=your_agent_id
WECHAT_WORK_SECRET=your_secret
WECHAT_WORK_TOKEN=your_token
WECHAT_WORK_ENCODING_AES_KEY=your_aes_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_publishable_key

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 1-click mailbox OAuth (Google Cloud + Azure/Entra app)
# Redirect URI to register with each provider (must match exactly):
#   ${NEXT_PUBLIC_APP_URL}/api/admin/connections/callback
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
MICROSOFT_OAUTH_CLIENT_ID=your_entra_client_id
MICROSOFT_OAUTH_CLIENT_SECRET=your_entra_client_secret
# Signing key for OAuth state + token encryption (any long random string)
OAUTH_STATE_SECRET=generate_a_long_random_string

# Web research / scraping provider used by catalog and knowledge scripts
EXA_API_KEY=your_exa_api_key

# --- Product analytics (optional) ---------------------------------------
# Leave NEXT_PUBLIC_POSTHOG_KEY empty and no analytics is loaded at all:
# the posthog-js chunk is never requested and every track() call is a no-op.
# Tracking is cookieless (no localStorage, no visitor id), which is why the
# privacy policy can describe it without a consent banner.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
